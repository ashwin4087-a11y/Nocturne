<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- NOCTURNE is an offline-first privacy transit application.
         Strictly prohibit cleartext (HTTP) traffic across the entire application domain. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
